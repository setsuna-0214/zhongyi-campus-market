# 将本文件复制为服务器上的 .env，然后把 CHANGE_ME 替换为真实值。

# 前端容器对外暴露端口。没有额外反向代理时用 80；如果宿主机已有 Nginx，可改为 8088 等端口。
APP_PORT=80

# MySQL 配置
MYSQL_ROOT_PASSWORD=CHANGE_ME_请填写强随机_ROOT_密码
DB_NAME=campus_market
DB_USERNAME=campus
DB_PASSWORD=CHANGE_ME_请填写强随机数据库密码

# JWT 配置。请使用至少 32 位的长随机字符串。
JWT_SECRET=CHANGE_ME_请填写至少32位的长随机JWT密钥
JWT_EXPIRATION_SECONDS=9000

# 邮箱验证码服务。仅本地演示且不需要验证码邮件时，账号密码可以暂时留空。
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=

# 阿里云 OSS 图片存储。公开服务器部署建议配置，避免图片随容器重建丢失。
OSS_ENDPOINT=oss-cn-shenzhen.aliyuncs.com
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET_NAME=
OSS_CDN_DOMAIN=

# 通义千问 DashScope AI 服务。可选；需要 AI 商品描述生成时必须配置。
AI_DASHSCOPE_API_KEY=
AI_DASHSCOPE_MODEL=qwen-vl-plus

# 上传限制
MAX_FILE_SIZE=10MB
MAX_REQUEST_SIZE=30MB
